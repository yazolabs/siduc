ARG PHP_VERSION=8.4
ARG COMPOSER_VERSION=2.8

FROM composer:${COMPOSER_VERSION} AS composer_source

FROM php:${PHP_VERSION}-fpm-alpine AS composer_builder
WORKDIR /app

RUN apk add --no-cache \
    git \
    unzip \
    libpng-dev \
    libzip-dev \
    postgresql-dev \
    postgresql17-client \
    $PHPIZE_DEPS \
 && docker-php-ext-install gd zip pdo pdo_pgsql pgsql pcntl ftp \
 && docker-php-ext-enable ftp \
 && apk del $PHPIZE_DEPS

COPY --from=composer_source /usr/bin/composer /usr/bin/composer

COPY . .
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN composer install --no-dev --optimize-autoloader --no-interaction

FROM node:20-alpine AS node_builder
WORKDIR /app

COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN yarn build

FROM php:${PHP_VERSION}-fpm-alpine AS php_runtime

RUN apk add --no-cache \
    libc-dev \
    libpng-dev \
    libzip-dev \
    linux-headers \
    postgresql-dev \
    postgresql17-client \
    ttf-dejavu \
    unzip \
    git \
    curl \
    bash

RUN apk add --no-cache --virtual .phpize_deps $PHPIZE_DEPS && \
    docker-php-ext-install bcmath gd pcntl pdo pdo_pgsql pgsql zip ftp && \
    docker-php-ext-enable bcmath gd pcntl pdo pdo_pgsql pgsql zip ftp && \
    apk del .phpize_deps

RUN docker-php-ext-install opcache

RUN addgroup -g 1000 ieducar && \
    adduser -G ieducar -g ieducar -s /bin/sh -D ieducar

WORKDIR /var/www/ieducar

COPY --chown=ieducar:ieducar \
    artisan \
    composer.json \
    composer.lock \
    package.json \
    vite.config.js \
    phpunit.xml \
    server.php \
    ./

COPY --chown=ieducar:ieducar app ./app
COPY --chown=ieducar:ieducar bootstrap ./bootstrap
COPY --chown=ieducar:ieducar config ./config
COPY --chown=ieducar:ieducar database ./database
COPY --chown=ieducar:ieducar public ./public
COPY --chown=ieducar:ieducar resources ./resources
COPY --chown=ieducar:ieducar routes ./routes
COPY --chown=ieducar:ieducar storage ./storage

COPY --from=composer_builder /app/vendor ./vendor
COPY --from=node_builder --chown=ieducar:ieducar /app/public/build ./public/build

RUN php artisan config:cache || true && \
    php artisan route:cache || true && \
    php artisan view:cache || true

RUN mkdir -p storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache && \
    chown -R ieducar:ieducar storage bootstrap/cache

USER ieducar
EXPOSE 9000
CMD ["php-fpm"]
