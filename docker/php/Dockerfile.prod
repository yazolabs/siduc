ARG PHP_VERSION=8.4
ARG COMPOSER_VERSION=2.8

FROM composer:${COMPOSER_VERSION} AS composer_source

FROM php:${PHP_VERSION}-fpm-alpine AS composer_builder
WORKDIR /app

RUN apk add --no-cache \
    git \
    unzip \
    libpng-dev \
    libzip-dev \
    postgresql-dev \
    postgresql17-client \
    $PHPIZE_DEPS \
 && docker-php-ext-install gd zip pdo pdo_pgsql pgsql pcntl ftp \
 && docker-php-ext-enable ftp \
 && apk del $PHPIZE_DEPS

COPY --from=composer_source /usr/bin/composer /usr/bin/composer

COPY . .
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN composer install --no-dev --optimize-autoloader --no-interaction

FROM node:22-alpine AS node_builder
WORKDIR /app

ARG CACHE_BUST
RUN echo "CACHE_BUST=$CACHE_BUST"

ARG VITE_GOOGLE_API_KEY
ARG VITE_FROALA_KEY

ENV VITE_GOOGLE_API_KEY=$VITE_GOOGLE_API_KEY
ENV VITE_FROALA_KEY=$VITE_FROALA_KEY

RUN echo "VITE_GOOGLE_API_KEY=$VITE_GOOGLE_API_KEY" \
 && test -n "$VITE_GOOGLE_API_KEY"

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

RUN yarn config set registry https://registry.npmjs.org \
 && yarn config set network-timeout 600000 -g

COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./vite.config.js
RUN yarn build

COPY packages/portabilis/pre-matricula-digital/package.json \
     packages/portabilis/pre-matricula-digital/yarn.lock* \
     /app/pmd/

RUN yarn --cwd /app/pmd install --frozen-lockfile --network-timeout 600000 --non-interactive

COPY packages/portabilis/pre-matricula-digital /app/pmd
RUN printf "VITE_GOOGLE_API_KEY=%s\nVITE_FROALA_KEY=%s\n" "$VITE_GOOGLE_API_KEY" "$VITE_FROALA_KEY" > /app/pmd/.env
RUN yarn --cwd /app/pmd build -- --base=/vendor/pre-matricula-digital/

FROM php:${PHP_VERSION}-fpm-alpine AS php_runtime

COPY --from=composer_source /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN apk add --no-cache \
    libc-dev \
    libpng-dev \
    libzip-dev \
    linux-headers \
    postgresql-dev \
    postgresql17-client \
    ttf-dejavu \
    unzip \
    git \
    curl \
    bash \
    openjdk17-jre-headless

RUN apk add --no-cache --virtual .phpize_deps $PHPIZE_DEPS && \
    docker-php-ext-install bcmath gd pcntl pdo pdo_pgsql pgsql zip ftp && \
    docker-php-ext-enable bcmath gd pcntl pdo pdo_pgsql pgsql zip ftp && \
    apk del .phpize_deps

RUN docker-php-ext-install opcache

RUN addgroup -g 1000 ieducar && \
    adduser -G ieducar -g ieducar -s /bin/sh -D ieducar

WORKDIR /var/www/ieducar

COPY --chown=ieducar:ieducar . .

COPY --from=composer_builder --chown=ieducar:ieducar /app/vendor ./vendor
COPY --from=node_builder --chown=ieducar:ieducar /app/public/build ./public/build

COPY --from=node_builder --chown=ieducar:ieducar /app/pmd/dist ./packages/portabilis/pre-matricula-digital/dist

RUN mkdir -p public/vendor/pre-matricula-digital \
 && cp -a packages/portabilis/pre-matricula-digital/dist/. public/vendor/pre-matricula-digital/

RUN mkdir -p storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache && \
    chown -R ieducar:ieducar storage bootstrap/cache

RUN php artisan config:cache || true && \
    php artisan route:cache || true && \
    php artisan view:cache || true

USER ieducar
EXPOSE 9000
CMD ["php-fpm"]
