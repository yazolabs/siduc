FROM node:22-alpine AS pmd_builder
WORKDIR /app/pmd

ARG CACHE_BUST
RUN echo "CACHE_BUST=$CACHE_BUST"

ARG VITE_GOOGLE_API_KEY
ARG VITE_FROALA_KEY

ENV VITE_GOOGLE_API_KEY=$VITE_GOOGLE_API_KEY
ENV VITE_FROALA_KEY=$VITE_FROALA_KEY

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

COPY packages/portabilis/pre-matricula-digital/package.json ./package.json
COPY packages/portabilis/pre-matricula-digital/yarn.lock* ./yarn.lock

RUN yarn install --frozen-lockfile --network-timeout 600000 --non-interactive

COPY packages/portabilis/pre-matricula-digital/ ./

RUN printf "VITE_GOOGLE_API_KEY=%s\nVITE_FROALA_KEY=%s\n" "$VITE_GOOGLE_API_KEY" "$VITE_FROALA_KEY" > .env

RUN yarn build -- --base=/vendor/pre-matricula-digital/

FROM nginx:1.28-alpine

ARG CACHE_BUST
RUN echo "CACHE_BUST=$CACHE_BUST"

RUN apk add --no-cache curl

COPY ./docker/nginx/conf.d/prod/default.conf /etc/nginx/conf.d/default.conf
COPY ./docker/nginx/conf.d/prod/upstream.conf /etc/nginx/conf.d/upstream.conf
COPY ./docker/nginx/snippets/prod/snippets.conf /etc/nginx/snippets/snippets.conf

WORKDIR /var/www/ieducar

COPY public /var/www/ieducar/public
COPY ieducar /var/www/ieducar/ieducar

RUN mkdir -p /var/www/ieducar/public/vendor/pre-matricula-digital
COPY --from=pmd_builder /app/pmd/dist/ /var/www/ieducar/public/vendor/pre-matricula-digital/

RUN chmod -R 755 /var/www/ieducar && \
    chown -R nginx:nginx /var/www/ieducar

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
